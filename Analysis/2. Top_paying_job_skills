/* What are the top paying skills for Business Analysts? 
- Use the results from the previous top paying Business Analyst query
- Add the specific skills required for these roles 
why? Show the required skills necessary for the top paying Business Analyst */

WITH top_paying_jobs AS (
    SELECT
        --company_dim.name as company_name,
        job_id,
        job_title,
        salary_year_avg,
        job_location

    FROM
        job_postings_fact
    LEFT JOIN company_dim ON job_postings_fact.company_id=company_dim.company_id
    WHERE
    job_location ='Anywhere' 
    AND
        job_title  Ilike '%Business Analyst%' 
    AND
        salary_year_avg is not NULL

    ORDER BY salary_year_avg DESC
    limit 10
)
select 
        top_paying_jobs.job_id,
        job_title,
        salary_year_avg,
        skills


FROM
    top_paying_jobs
	INNER JOIN
    skills_job_dim ON top_paying_jobs.job_id = skills_job_dim.job_id
	INNER JOIN
    skills_dim ON skills_job_dim.skill_id = skills_dim.skill_id

ORDER BY 
    salary_year_avg DESC

limit 10