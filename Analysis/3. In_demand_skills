/* What are the most in-demand skills for Business Analysts?
    I want to show the skills necessary for jobs that make over $50k*/

-- Identifies the top 5 most demanded skills for Data Analyst job postings
SELECT
  skills_dim.skills,
  COUNT(skills_job_dim.job_id) AS demand_count
  
FROM
  job_postings_fact
  INNER JOIN
    skills_job_dim ON job_postings_fact.job_id = skills_job_dim.job_id
  INNER JOIN
    skills_dim ON skills_job_dim.skill_id = skills_dim.skill_id
WHERE
    job_postings_fact.job_title Ilike '%Business Analyst%'  --Gives only job posts for Business Analysts
AND 
    job_postings_fact.salary_year_avg > 50000 -- Displays jobs that make over $50k

GROUP BY
  skills_dim.skills
ORDER BY
  demand_count DESC

limit 5 